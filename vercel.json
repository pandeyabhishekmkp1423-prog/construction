{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/(robots\\.txt|sitemap\\.xml|favicon\\.svg|favicon\\.ico)$",
      "dest": "/$1"
    },
    {
      "src": "^/(config|includes|storage|screenshots)(/.*)?$",
      "status": 403
    },
    {
      "src": "^/.*\\.(log|jsonl|json|env|md|zip|sql|bak)$",
      "status": 403
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.php"
    }
  ]
}

